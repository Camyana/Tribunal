# Local WoW state, never part of the addon
*.bak
*.old
SavedVariables/

# Python bytecode from the tooling
__pycache__/
*.pyc

# Working renders. The scripts that produce them are tracked; the output is not.
Art/review/
Art/review2/
Art/source/*.png
Art/*.png

# Brand assets are deliverables and are kept.
!Art/brand/*.png
